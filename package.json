{
  "name": "gto-self",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @gto-self/web dev",
    "dev:fishtilt": "pnpm --filter @gto-self/fishtilt dev",
    "build": "pnpm --filter @gto-self/web build",
    "build:fishtilt": "pnpm --filter @gto-self/fishtilt build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "pnpm --filter @gto-self/web e2e",
    "e2e:fishtilt": "pnpm --filter @gto-self/fishtilt e2e",
    "db:generate": "pnpm --filter @gto-self/db db:generate",
    "db:migrate": "pnpm --filter @gto-self/db db:migrate",
    "strategy:backfill": "pnpm --filter @gto-self/web strategy:backfill",
    "adaptive:backfill": "pnpm --filter @gto-self/web adaptive:backfill",
    "players:import-external": "pnpm --filter @gto-self/web players:import-external",
    "verify": "pnpm typecheck && pnpm test && pnpm lint && pnpm lint:licences && pnpm build",
    "lint:licences": "node scripts/check-licence-hygiene.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "eslint-plugin-react-hooks": "^7.1.1"
  }
}
