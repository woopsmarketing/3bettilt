{
  "name": "@gto-self/learn-core",
  "version": "0.0.0",
  "private": true,
  "description": "FishTilt's beginner-education domain: pot odds, outs, exact heads-up equity and starting-hand facts. Pure, deterministic, no UI.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "generate:strength": "tsx scripts/generate-hand-strength.ts",
    "generate:classVsClass": "tsx scripts/generate-class-vs-class-equity.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project learn-core"
  },
  "dependencies": {
    "@gto-self/shared": "workspace:*",
    "@gto-self/strategy-core": "workspace:*"
  }
}
