{
  "name": "@gto-self/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle ORM + SQLite persistence. Storage only, never game logic.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@gto-self/shared": "workspace:*",
    "@gto-self/poker-core": "workspace:*",
    "@gto-self/gto-core": "workspace:*",
    "@gto-self/player-core": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.10"
  }
}
